{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Madyar service catalog v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "catalogVersion",
    "coverage",
    "services"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "catalogVersion": {
      "type": "string",
      "minLength": 1
    },
    "coverage": {
      "const": "seed-not-exhaustive"
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/service"
      }
    }
  },
  "$defs": {
    "service": {
      "type": "object",
      "required": [
        "id",
        "name",
        "aliases",
        "category",
        "enabledInRuPreset",
        "route",
        "rules",
        "endToEndVerified"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "category": {
          "type": "string"
        },
        "enabledInRuPreset": {
          "type": "boolean"
        },
        "route": {
          "enum": [
            "direct",
            "proxy"
          ]
        },
        "endToEndVerified": {
          "type": "boolean"
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "match",
        "value",
        "evidence",
        "sources"
      ],
      "properties": {
        "match": {
          "enum": [
            "domain_suffix",
            "domain"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 3,
          "pattern": "^[a-z0-9.-]+$"
        },
        "evidence": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
